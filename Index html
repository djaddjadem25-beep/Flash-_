const sb = {
  h: { "Content-Type": "application/json", apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
  ah(token) { return { ...this.h, Authorization: `Bearer ${token}` }; },
  async signUp(email, password) {
    const r = await fetch(`${SUPABASE_URL}/auth/v1/signup`, { method: "POST", headers: this.h, body: JSON.stringify({ email, password }) });
    return r.json();
  },
  async signIn(email, password) {
    const r = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, { method: "POST", headers: this.h, body: JSON.stringify({ email, password }) });
    return r.json();
  },
  async signOut(token) {
    await fetch(`${SUPABASE_URL}/auth/v1/logout`, { method: "POST", headers: this.ah(token) });
  },
  async getWorkflows(token) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/workflows?order=created_at.desc`, { headers: this.ah(token) });
    return r.json();
  },
  async saveWorkflow(token, wf) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/workflows`, { method: "POST", headers: { ...this.ah(token), Prefer: "return=representation" }, body: JSON.stringify(wf) });
    return r.json();
  },
  async updateWorkflow(token, id, patch) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/workflows?id=eq.${id}`, { method: "PATCH", headers: { ...this.ah(token), Prefer: "return=representation" }, body: JSON.stringify(patch) });
    return r.json();
  },
  async deleteWorkflow(token, id) {
    await fetch(`${SUPABASE_URL}/rest/v1/workflows?id=eq.${id}`, { method: "DELETE", headers: this.ah(token) });
  },
  async getLogs(token) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/logs?order=created_at.desc&limit=50`, { headers: this.ah(token) });
    return r.json();
  },
  async saveLog(token, log) {
    await fetch(`${SUPABASE_URL}/rest/v1/logs`, { method: "POST", headers: this.ah(token), body: JSON.stringify(log) });
  }
};

const C = {
  bg: "#0a0a0a", surface: "#111111", border: "#1e1e1e", border2: "#2a2a2a",
  text: "#e8e8e8", muted: "#555555", dim: "#333333",
  accent: "#4f8fff", accentDim: "#0d1f3c",
  green: "#3ddc84", red: "#ff5f57", yellow: "#ffc107", purple: "#a78bfa",
};

const STEP_TYPES = {
  trigger_manual: { label: "Manual Trigger", color: C.green, icon: "▶" },
  trigger_webhook: { label: "Webhook", color: C.accent, icon: "⚡" },
  trigger_schedule: { label: "Schedule", color: C.yellow, icon: "⏰" },
  action_http: { label: "HTTP Request", color: C.accent, icon: "🌐" },
  action_ai: { label: "AI Step", color: C.purple, icon: "◈" },
  action_condition: { label: "Condition", color: C.yellow, icon: "◇" },
  action_transform: { label: "Transform", color: C.text, icon: "⟳" },
  action_mcp: { label: "MCP Tool", color: C.green, icon: "⬡" },
};

function uid() { return Math.random().toString(36).slice(2, 9); }

function AuthPage({ onAuth }) {
  const [mode, setMode] = useState("signin");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const handle = async () => {
    if (!email || !password) return setError("Fill all fields");
    setLoading(true); setError("");
    try {
      const data = mode === "signin" ? await sb.signIn(email, password) : await sb.signUp(email, password);
      if (data.access_token) {
        localStorage.setItem("flash_token", data.access_token);
        localStorage.setItem("flash_user", JSON.stringify(data.user));
        onAuth({ token: data.access_token, user: data.user });
      } else if (data.error_description || data.msg) {
        setError(data.error_description || data.msg);
      } else if (mode === "signup") {
        setError("Account created! Check email to confirm, then sign in.");
      }
    } catch (e) { setError(e.message); }
    setLoading(false);
  };

  return (
    <div style={{ minHeight: "100vh", background: C.bg, display: "flex", alignItems: "center", justifyContent: "center" }}>
      <div style={{ width: 340, background: C.surface, border: `1px solid ${C.border}`, borderRadius: 8, padding: 32 }}>
        <div style={{ fontWeight: 700, fontSize: 22, letterSpacing: 6, color: C.text, marginBottom: 4 }}>FLASH</div>
        <div style={{ fontSize: 10, color: C.muted, letterSpacing: 2, marginBottom: 28 }}>AUTOMATION</div>
        {[["EMAIL", "email", email, setEmail], ["PASSWORD", "password", password, setPassword]].map(([label, type, val, set]) => (
          <div key={label} style={{ marginBottom: 12 }}>
            <div style={{ fontSize: 10, color: C.muted, marginBottom: 4, letterSpacing: 1 }}>{label}</div>
            <input type={type} value={val} onChange={e => set(e.target.value)} onKeyDown={e => e.key === "Enter" && handle()}
              style={{ width: "100%", background: C.bg, border: `1px solid ${C.border2}`, color: C.text, padding: "8px 10px", fontSize: 12, borderRadius: 4, outline: "none" }} />
          </div>
        ))}
        {error && <div style={{ fontSize: 11, color: error.includes("created") ? C.green : C.red, marginBottom: 10 }}>{error}</div>}
        <button onClick={handle} disabled={loading}
          style={{ width: "100%", padding: "9px 0", background: C.accentDim, border: `1px solid ${C.accent}`, color: C.accent, cursor: "pointer", fontSize: 12, borderRadius: 4, marginBottom: 12 }}>
          {loading ? "..." : mode === "signin" ? "Sign In" : "Create Account"}
        </button>
        <div style={{ textAlign: "center", fontSize: 11, color: C.muted, cursor: "pointer" }} onClick={() => { setMode(m => m === "signin" ? "signup" : "signin"); setError(""); }}>
          {mode === "signin" ? "No account? Sign up" : "Have account? Sign in"}
        </div>
      </div>
    </div>
  );
}

function StepCard({ step, onUpdate, onDelete, index, total }) {
  const [open, setOpen] = useState(false);
  const meta = STEP_TYPES[step.type] || STEP_TYPES.action_http;

  const inp = (label, key, placeholder = "", type = "text") => (
    <div style={{ marginBottom: 8 }}>
      <div style={{ fontSize: 10, color: C.muted, marginBottom: 3 }}>{label}</div>
      <input type={type} value={step.config?.[key] || ""} onChange={e => onUpdate({ config: { ...step.config, [key]: e.target.value } })} placeholder={placeholder}
        style={{ width: "100%", background: C.bg, border: `1px solid ${C.border2}`, color: C.text, padding: "5px 8px", fontSize: 11, borderRadius: 3, outline: "none" }} />
    </div>
  );

  const ta = (label, key, placeholder = "") => (
    <div style={{ marginBottom: 8 }}>
      <div style={{ fontSize: 10, color: C.muted, marginBottom: 3 }}>{label}</div>
      <textarea value={step.config?.[key] || ""} onChange={e => onUpdate({ config: { ...step.config, [key]: e.target.value } })} placeholder={placeholder} rows={3}
        style={{ width: "100%", background: C.bg, border: `1px solid ${C.border2}`, color: C.text, padding: "5px 8px", fontSize: 11, borderRadius: 3, resize: "vertical", outline: "none" }} />
    </div>
  );

  return (
    <div>
      <div onClick={() => setOpen(o => !o)}
        style={{ background: C.surface, border: `1px solid ${open ? meta.color : C.border}`, borderRadius: open ? "6px 6px 0 0" : 6, padding: "10px 14px", cursor: "pointer", display: "flex", alignItems: "center", gap: 10, userSelect: "none" }}>
        <span style={{ color: C.muted, fontSize: 10, width: 16 }}>{index + 1}</span>
        <span style={{ color: meta.color, fontSize: 13 }}>{meta.icon}</span>
        <input value={step.label} onChange={e => { e.stopPropagation(); onUpdate({ label: e.target.value }); }} onClick={e => e.stopPropagation()}
          style={{ background: "transparent", border: "none", color: C.text, fontSize: 12, flex: 1, outline: "none" }} />
        <span style={{ fontSize: 10, color: C.muted }}>{meta.label}</span>
        <button onClick={e => { e.stopPropagation(); onDelete(); }}
          style={{ background: "transparent", border: "none", color: C.muted, cursor: "pointer", fontSize: 16, lineHeight: 1 }}>×</button>
      </div>
      {open && (
        <div style={{ background: C.surface, border: `1px solid ${meta.color}`, borderTop: "none", borderRadius: "0 0 6px 6px", padding: "12px 14px" }}>
          {step.type === "action_http" && <>{inp("URL", "url", "https://api.example.com")}{inp("Method", "method", "GET")}{inp("Headers (JSON)", "headers", '{"Authorization":"Bearer ..."}')}{ta("Body", "body")}</>}
          {step.type === "action_ai" && <>{ta("Prompt", "prompt", "Summarize this data...")}
            <div style={{ marginBottom: 8 }}>
              <div style={{ fontSize: 10, color: C.muted, marginBottom: 3 }}>ANTHROPIC API KEY</div>
              <input type="password" value={step.config?.apikey || ""} onChange={e => onUpdate({ config: { ...step.config, apikey: e.target.value } })} placeholder="sk-ant-..."
                style={{ width: "100%", background: C.bg, border: `1px solid ${C.border2}`, color: C.text, padding: "5px 8px", fontSize: 11, borderRadius: 3, outline: "none" }} />
            </div>
          </>}
          {step.type === "action_mcp" && <>{inp("MCP Server URL", "mcp_url", "https://mcp.example.com/sse")}{inp("Tool Name", "tool_name")}{ta("Tool Input (JSON)", "tool_input")}</>}
          {step.type === "action_condition" && <>{inp("Field", "field", "response.status")}{inp("Operator", "operator", "equals")}{inp("Value", "value", "200")}</>}
          {step.type === "action_transform" && ta("Expression", "expression", "data.results.map(r => r.name)")}
          {step.type === "trigger_webhook" && inp("Path", "path", "/hooks/my-flow")}
          {step.type === "trigger_schedule" && inp("Cron", "cron", "0 9 * * 1-5")}
          {step.type === "trigger_manual" && <div style={{ fontSize: 11, color: C.muted }}>Triggered manually via Run button.</div>}
        </div>
      )}
      {index < total - 1 && (
        <div style={{ display: "flex", justifyContent: "center", padding: "3px 0" }}>
          <div style={{ width: 1, height: 16, background: C.border2 }} />
        </div>
      )}
    </div>
  );
}

async function runSteps(steps, onLog) {
  let context = {};
  let hasError = false;
  for (const step of steps) {
    onLog(`\n▸ ${step.label}\n`);
    try {
      if (step.type === "trigger_manual") {
        context.trigger = { timestamp: new Date().toISOString() };
        onLog(`  ✓ Triggered\n`);
      } else if (step.type === "action_http") {
        const url = step.config?.url;
        if (!url) { onLog(`  ✗ No URL\n`); hasError = true; continue; }
        const res = await fetch(url, { method: step.config?.method || "GET", headers: step.config?.headers ? JSON.parse(step.config.headers) : {} });
        const data = await res.json().catch(() => ({}));
        context.http = data;
        onLog(`  ✓ ${res.status} — ${JSON.stringify(data).slice(0, 200)}\n`);
      } else if (step.type === "action_ai") {
        const apiKey = step.config?.apikey;
        if (!apiKey) { onLog(`  ✗ No Anthropic API key in step config\n`); hasError = true; continue; }
        onLog(`  ◈ Calling Claude...\n`);
        const prompt = (step.config?.prompt || "Process:") + "\n\nContext: " + JSON.stringify(context).slice(0, 500);
        const res = await fetch("https://api.anthropic.com/v1/messages", {
          method: "POST",
          headers: { "Content-Type": "application/json", "x-api-key": apiKey, "anthropic-version": "2023-06-01" },
          body: JSON.stringify({ model: "claude-sonnet-4-6", max_tokens: 1000, messages: [{ role: "user", content: prompt }] })
        });
        const data = await res.json();
        const text = data.content?.map(c => c.text || "").join("") || JSON.stringify(data);
        context.ai = text;
        onLog(`  ✓ ${text.slice(0, 300)}\n`);
      } else if (step.type === "action_condition") {
        const val = step.config?.field?.split(".").reduce((o, k) => o?.[k], context);
        const pass = String(val) === String(step.config?.value || "");
        context.condition = pass;
        onLog(`  ${pass ? "✓" : "✗"} ${val} ${step.config?.operator} ${step.config?.value} → ${pass ? "pass" : "fail"}\n`);
      } else if (step.type === "action_transform") {
        const result = new Function("data", "context", `return ${step.config?.expression}`)(context.http, context);
        context.transform = result;
        onLog(`  ✓ ${JSON.stringify(result).slice(0, 200)}\n`);
      } else if (step.type === "action_mcp") {
        onLog(`  ⬡ MCP: ${step.config?.mcp_url} → ${step.config?.tool_name}\n  (Requires local MCP server)\n`);
      } else {
        onLog(`  ✓ done\n`);
      }
    } catch (e) { onLog(`  ✗ ${e.message}\n`); hasError = true; }
  }
  onLog(`\n${hasError ? "— Completed with errors —" : "— Done ✓ —"}\n`);
  return { hasError, context };
}

function WorkflowEditor({ wf, token, onSave, onBack }) {
  const [steps, setSteps] = useState(wf.steps || []);
  const [name, setName] = useState(wf.name || "Untitled");
  const [running, setRunning] = useState(false);
  const [saving, setSaving] = useState(false);
  const [log, setLog] = useState("");

  const addStep = type => setSteps(s => [...s, { id: uid(), type, label: STEP_TYPES[type].label, config: {} }]);
  const updateStep = (id, patch) => setSteps(s => s.map(st => st.id === id ? { ...st, ...patch } : st));
  const deleteStep = id => setSteps(s => s.filter(st => st.id !== id));

  const save = async () => {
    setSaving(true);
    await onSave({ ...wf, name, steps });
    setSaving(false);
  };

  const run = async () => {
    setRunning(true);
    setLog("Starting...\n");
    let fullLog = "Starting...\n";
    const { hasError } = await runSteps(steps, chunk => { fullLog += chunk; setLog(fullLog); });
    await sb.saveLog(token, { flow_name: name, status: hasError ? "error" : "success", message: fullLog.slice(0, 300) });
    setRunning(false);
  };

  return (
    <div style={{ display: "flex", height: "100vh", background: C.bg }}>
      <div style={{ flex: 1, display: "flex", flexDirection: "column", overflow: "hidden" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, padding: "10px 16px", borderBottom: `1px solid ${C.border}`, background: C.surface }}>
          <button onClick={onBack} style={{ background: "transparent", border: "none", color: C.muted, cursor: "pointer", fontSize: 18 }}>←</button>
          <input value={name} onChange={e => setName(e.target.value)}
            style={{ background: "transparent", border: "none", color: C.text, fontSize: 14, fontWeight: 700, outline: "none", flex: 1 }} />
          <button onClick={save} disabled={saving}
            style={{ padding: "5px 14px", background: "transparent", border: `1px solid ${C.border2}`, color: saving ? C.muted : C.text, cursor: "pointer", fontSize: 11, borderRadius: 3 }}>
            {saving ? "Saving..." : "Save"}
          </button>
          <button onClick={run} disabled={running}
            style={{ padding: "5px 14px", background: running ? C.dim : C.accentDim, border: `1px solid ${running ? C.muted : C.accent}`, color: running ? C.muted : C.accent, cursor: running ? "not-allowed" : "pointer", fontSize: 11, borderRadius: 3 }}>
            {running ? "⟳ Running" : "▶ Run"}
          </button>
        </div>
        <div style={{ flex: 1, overflowY: "auto", padding: 24 }}>
          <div style={{ maxWidth: 520 }}>
            {steps.length === 0 && <div style={{ color: C.muted, fontSize: 12, padding: "20px 0" }}>No steps yet — add one below ↓</div>}
            {steps.map((step, i) => (
              <StepCard key={step.id} step={step} index={i} total={steps.length}
                onUpdate={patch => updateStep(step.id, patch)} onDelete={() => deleteStep(step.id)} />
            ))}
            <div style={{ marginTop: 16 }}>
              <div style={{ fontSize: 10, color: C.muted, letterSpacing: 2, marginBottom: 8 }}>ADD STEP</div>
              <div style={{ display: "flex", flexWrap: "wrap", gap: 6 }}>
                {Object.entries(STEP_TYPES).map(([type, meta]) => (
                  <button key={type} onClick={() => addStep(type)}
                    style={{ padding: "5px 10px", background: "transparent", border: `1px solid ${C.border2}`, color: meta.color, cursor: "pointer", fontSize: 11, borderRadius: 3 }}>
                    {meta.icon} {meta.label}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div style={{ width: 280, borderLeft: `1px solid ${C.border}`, background: C.surface, display: "flex", flexDirection: "column" }}>
        <div style={{ padding: "10px 14px", borderBottom: `1px solid ${C.border}`, fontSize: 10, color: C.muted, letterSpacing: 2 }}>OUTPUT</div>
        <div style={{ flex: 1, overflowY: "auto", padding: 12, fontSize: 10, color: C.text, whiteSpace: "pre-wrap", wordBreak: "break-all", lineHeight: 1.6 }}>
          {log || <span style={{ color: C.muted }}>Run to see output</span>}
        </div>
      </div>
    </div>
  );
}

function App() {
  const [session, setSession] = useState(null);
  const [page, setPage] = useState("flows");
  const [workflows, setWorkflows] = useState([]);
  const [logs, setLogs] = useState([]);
  const [editing, setEditing] = useState(null);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const token = localStorage.getItem("flash_token");
    const user = localStorage.getItem("flash_user");
    if (token && user) setSession({ token, user: JSON.parse(user) });
  }, []);

  const load = useCallback(async () => {
    if (!session) return;
    setLoading(true);
    const [wfs, ls] = await Promise.all([sb.getWorkflows(session.token), sb.getLogs(session.token)]);
    setWorkflows(Array.isArray(wfs) ? wfs : []);
    setLogs(Array.isArray(ls) ? ls : []);
    setLoading(false);
  }, [session]);

  useEffect(() => { load(); }, [load]);

  const handleAuth = s => setSession(s);

  const handleSignOut = async () => {
    if (session?.token) await sb.signOut(session.token);
    localStorage.removeItem("flash_token");
    localStorage.removeItem("flash_user");
    setSession(null);
  };

  const newFlow = async () => {
    const res = await sb.saveWorkflow(session.token, { name: "New Flow", steps: [], enabled: false });
    const saved = Array.isArray(res) ? res[0] : res;
    if (saved?.id) { setWorkflows(w => [saved, ...w]); setEditing(saved); }
  };

  const saveFlow = async wf => {
    const res = await sb.updateWorkflow(session.token, wf.id, { name: wf.name, steps: wf.steps, enabled: wf.enabled });
    const updated = Array.isArray(res) ? res[0] : res;
    if (updated?.id) setWorkflows(w => w.map(x => x.id === updated.id ? updated : x));
  };

  const deleteFlow = async id => {
    await sb.deleteWorkflow(session.token, id);
    setWorkflows(w => w.filter(x => x.id !== id));
  };

  if (!session) return <AuthPage onAuth={handleAuth} />;

  if (editing) return (
    <WorkflowEditor wf={editing} token={session.token}
      onSave={async wf => { await saveFlow(wf); setEditing(wf); }}
      onBack={() => { setEditing(null); load(); }} />
  );

  return (
    <div style={{ display: "flex", height: "100vh", background: C.bg }}>
      <div style={{ width: 180, background: C.surface, borderRight: `1px solid ${C.border}`, display: "flex", flexDirection: "column" }}>
        <div style={{ padding: "18px 16px 14px", borderBottom: `1px solid ${C.border}` }}>
          <div style={{ fontWeight: 700, fontSize: 15, letterSpacing: 4, color: C.text }}>FLASH</div>
          <div style={{ fontSize: 9, color: C.muted, marginTop: 2, letterSpacing: 2 }}>AUTOMATION</div>
        </div>
        <nav style={{ padding: "8px 0", flex: 1 }}>
          {[["flows", "⬡", "Flows"], ["logs", "≡", "Logs"]].map(([id, icon, label]) => (
            <button key={id} onClick={() => setPage(id)}
              style={{ display: "flex", alignItems: "center", gap: 10, width: "100%", padding: "8px 16px", background: page === id ? C.accentDim : "transparent", border: "none", borderLeft: page === id ? `2px solid ${C.accent}` : "2px solid transparent", color: page === id ? C.accent : C.muted, cursor: "pointer", fontSize: 12 }}>
              {icon} {label}
            </button>
          ))}
        </nav>
        <div style={{ padding: "10px 16px", borderTop: `1px solid ${C.border}` }}>
          <div style={{ fontSize: 10, color: C.muted, marginBottom: 6, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
            {session.user?.email?.split("@")[0] || "user"}
          </div>
          <button onClick={handleSignOut}
            style={{ background: "transparent", border: `1px solid ${C.border2}`, color: C.muted, cursor: "pointer", fontSize: 10, borderRadius: 3, padding: "3px 8px" }}>
            Sign out
          </button>
        </div>
      </div>

      <div style={{ flex: 1, overflowY: "auto" }}>
        {page === "flows" && (
          <div style={{ padding: 28 }}>
            <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 20 }}>
              <div>
                <div style={{ fontSize: 10, color: C.muted, letterSpacing: 2, marginBottom: 4 }}>WORKFLOWS</div>
                <div style={{ fontSize: 20, fontWeight: 700, color: C.text }}>{workflows.length} Flows</div>
              </div>
              <button onClick={newFlow}
                style={{ padding: "7px 16px", background: C.accentDim, border: `1px solid ${C.accent}`, color: C.accent, cursor: "pointer", fontSize: 11, borderRadius: 4 }}>
                + New Flow
              </button>
            </div>
            {loading && <div style={{ color: C.muted, fontSize: 12 }}>Loading...</div>}
            {!loading && workflows.length === 0 && <div style={{ color: C.muted, fontSize: 12 }}>No flows yet. Create your first one!</div>}
            {workflows.map(wf => (
              <div key={wf.id} onClick={() => setEditing(wf)}
                style={{ background: C.surface, border: `1px solid ${C.border}`, borderRadius: 6, padding: "14px 16px", marginBottom: 8, display: "flex", alignItems: "center", gap: 12, cursor: "pointer" }}>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 13, color: C.text, marginBottom: 3 }}>{wf.name}</div>
                  <div style={{ fontSize: 10, color: C.muted }}>{(wf.steps || []).length} steps · {new Date(wf.created_at).toLocaleDateString()}</div>
                </div>
                <span style={{ fontSize: 10, color: wf.enabled ? C.green : C.muted }}>{wf.enabled ? "● active" : "○ off"}</span>
                <button onClick={e => { e.stopPropagation(); deleteFlow(wf.id); }}
                  style={{ background: "transparent", border: `1px solid ${C.border2}`, color: C.muted, cursor: "pointer", fontSize: 11, borderRadius: 3, padding: "3px 8px" }}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        )}
        {page === "logs" && (
          <div style={{ padding: 28 }}>
            <div style={{ fontSize: 10, color: C.muted, letterSpacing: 2, marginBottom: 4 }}>EXECUTION HISTORY</div>
            <div style={{ fontSize: 20, fontWeight: 700, color: C.text, marginBottom: 20 }}>Logs</div>
            {loading && <div style={{ color: C.muted, fontSize: 12 }}>Loading...</div>}
            {!loading && logs.length === 0 && <div style={{ color: C.muted, fontSize: 12 }}>No runs yet.</div>}
            {logs.map(l => (
              <div key={l.id} style={{ background: C.surface, border: `1px solid ${C.border}`, borderRadius: 5, padding: "10px 14px", marginBottom: 6, display: "flex", gap: 12, alignItems: "center" }}>
                <span style={{ fontSize: 11, color: l.status === "success" ? C.green : C.red, minWidth: 50 }}>{l.status}</span>
                <span style={{ fontSize: 11, color: C.text, minWidth: 120 }}>{l.flow_name}</span>
                <span style={{ fontSize: 10, color: C.muted, flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{l.message}</span>
                <span style={{ fontSize: 10, color: C.muted }}>{new Date(l.created_at).toLocaleTimeString()}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

ReactDOM.render(<App />, document.getElementById("root"));
</script>
</body>
</html>
